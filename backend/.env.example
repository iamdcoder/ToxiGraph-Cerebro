APP_NAME=CEREBRO
APP_VERSION=0.2.0
DEBUG=true

API_PREFIX=/api/v1

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# auto | transformer | heuristic
# auto is recommended for the hackathon demo: use HF models when available,
# then fall back to deterministic local scoring if loading/inference fails.
MODEL_MODE=auto
MODEL_BATCH_SIZE=4

SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
TOXICITY_MODEL=unitary/unbiased-toxic-roberta
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
